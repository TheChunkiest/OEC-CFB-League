rules_version = '2';
// OEC CFB League Hub — paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isCommish() { return hasProfile() && userDoc().data.role == 'commish'; }
    function isCoach() { return hasProfile() && userDoc().data.teamId != ''; }
    function league() { return get(/databases/$(database)/documents/meta/league).data; }
    function gameOf(id) { return get(/databases/$(database)/documents/games/$(id)).data; }

    // League data: everyone can read, only the commissioner can change it.
    match /meta/{doc} { allow read: if true; allow write: if isCommish(); }
    match /teams/{id} { allow read: if true; allow write: if isCommish(); }
    match /games/{id} { allow read: if true; allow write: if isCommish(); }
    match /history/{id} { allow read: if true; allow write: if isCommish(); }

    // Coach profiles. New sign-ups start unlinked; only the commissioner links teams or grants roles.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'teamId', 'role', 'upd'])
        && request.resource.data.role == 'coach' && request.resource.data.teamId == ''
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow update: if isCommish() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'upd']));
      allow delete: if isCommish();
    }

    // Wagers: a linked coach may bet on any unplayed game this week or later at its posted line,
    // or on the League Champion future at the posted odds during the regular season.
    // League rule: never on their own team's games, win total or title odds (t = the bettor's team).
    function baseWager(d, L) {
      return d.uid == request.auth.uid && d.status == 'open' && d.payout == 0
        && d.stake is int && d.stake >= 1 && d.stake <= 100000
        && L.bettingOpen == true && d.season == L.season && d.week == L.week;
    }
    // Missing fields are read with defaults (an unplayed game may have no score field at all, and older lines
    // have no juice fields, which the site prices at -110), so a missing field never blocks a valid bet.
    // Firestore stops evaluating a request after 1,000 expressions, so the bet checks are kept as lean as possible.
    // Fast path: each game's posted lines carry two lookup maps the site writes with the line,
    //   o = price by "market_pick" (e.g. o.spread_home = -120) and v = line by market (e.g. v.spread = -14).
    // A pick must match o[market_pick] (a key that isn't there means the pick isn't on the board) and, except for
    // moneylines, v[market]. Lines posted before the maps existed fall back to the longer check below.
    function fastGame(d, ln) {
      return d.odds == ln.o[d.market + '_' + d.pick] && (d.market == 'ml' || d.line == ln.v[d.market]);
    }
    function oddsKey(m, p) {
      return m == 'ml' ? (p == 'home' ? 'mlHome' : 'mlAway')
        : m == 'spread' ? (p == 'home' ? 'spreadOddsHome' : 'spreadOddsAway')
        : m == 'total' ? (p == 'over' ? 'overOdds' : 'underOdds')
        : m == 'tth' ? (p == 'over' ? 'ttHomeOver' : 'ttHomeUnder')
        : (p == 'over' ? 'ttAwayOver' : 'ttAwayUnder');
    }
    function lineKey(m) { return m == 'spread' ? 'spread' : m == 'total' ? 'total' : m == 'tth' ? 'ttHome' : 'ttAway'; }
    function slowGame(d, ln) {
      return d.market in ['ml', 'spread', 'total', 'tth', 'tta']
        && d.pick in (d.market in ['ml', 'spread'] ? ['home', 'away'] : ['over', 'under'])
        && d.odds == ln.get(oddsKey(d.market, d.pick), d.market == 'ml' ? null : -110)
        && (d.market == 'ml' || (d.line != null && d.line == ln.get(lineKey(d.market), null)));
    }
    function validGameWager(d, t, L) {
      let g = gameOf(d.gameId);
      let ln = g.get('lines', {});
      return g.home != t && g.away != t && g.season == L.season && g.week >= L.week && g.get('homeScore', null) == null && g.get('locked', false) != true
        && ('o' in ln ? fastGame(d, ln) : slowGame(d, ln));
    }
    function validFuture(d, L, t) {
      return d.pick != t && L.phase == 'Regular Season' && L.futures.season == L.season && L.futures.open == true
        && d.pick in L.futures.odds && d.odds is int && d.odds == L.futures.odds[d.pick];
    }
    // Parlay: 2-6 legs, each checked like a single bet (game line or League Champion odds).
    function validWins(d, L, t) {
      let o = L.winTotals.odds[d.team];
      return d.team != t && L.phase == 'Regular Season' && L.winTotals.season == L.season && d.team is string && d.team in L.winTotals.odds
        && d.line == o.line && ((d.pick == 'over' && d.odds == o.over) || (d.pick == 'under' && d.odds == o.under));
    }
    function validLeg(leg, L, t) {
      return leg.gameId != '' ? validGameWager(leg, t, L)
        : ((leg.market == 'future' && validFuture(leg, L, t)) || (leg.market == 'wins' && validWins(leg, L, t)));
    }
    // Same-game parlay limits (one side pick and one points pick per game) are enforced by the site's bet slip, not
    // here: checking every pair of legs cost more than the leg checks themselves and pushed parlays past Firestore's
    // per-request evaluation limit.
    function validParlay(d, L, t) {
      let n = d.legs.size();
      return d.legs is list && n >= 2 && n <= 6
        && validLeg(d.legs[0], L, t) && validLeg(d.legs[1], L, t)
        && (n < 3 || validLeg(d.legs[2], L, t)) && (n < 4 || validLeg(d.legs[3], L, t))
        && (n < 5 || validLeg(d.legs[4], L, t)) && (n < 6 || validLeg(d.legs[5], L, t));
    }
    // Profit boosts, only on single bets on one game or parlays made only of that game's lines:
    // Game of the Week +10%, League Championship Game +25%, Season Opener +15% (moneyline only).
    function boostGid(d) { return d.market == 'parlay' ? d.legs[0].get('gameId', '') : d.get('gameId', ''); }
    function legOn(ls, i, gid) { return ls.size() <= i || ls[i].get('gameId', '') == gid; }
    function allOn(d, gid) {
      return gid != '' && ((d.market in ['ml', 'spread', 'total', 'tth', 'tta'] && d.gameId == gid)
        || (d.market == 'parlay' && legOn(d.legs, 0, gid) && legOn(d.legs, 1, gid) && legOn(d.legs, 2, gid)
          && legOn(d.legs, 3, gid) && legOn(d.legs, 4, gid) && legOn(d.legs, 5, gid)));
    }
    function validBoost(d, L) {
      return !('boost' in d)
        || (d.boost == 1.1 && L.gotw.season == L.season && L.gotw.week == L.week && allOn(d, L.gotw.gameId))
        || (d.boost == 1.25 && allOn(d, boostGid(d)) && gameOf(boostGid(d)).get('type', 'reg') == 'ccg')
        // Season Opener +15%: moneyline singles on the game the commissioner set as the opener.
        || (d.boost == 1.15 && d.market == 'ml' && L.get('opener', {}).get('season', 0) == L.season && d.gameId == L.get('opener', {}).get('gameId', ''));
    }
    // The league doc and the bettor's profile are each read once here and passed down, so even a 6-leg parlay
    // stays well under Firestore's limit of 10 document lookups per request (profile + league + up to 6 games).
    function validWager(d) {
      let u = userDoc().data;
      let L = league();
      let t = u.teamId;
      // Spectators (signed-up accounts with no team, t == '') bet like everyone else; own-team limits just don't apply.
      return baseWager(d, L) && validBoost(d, L) && ((d.market == 'future' && validFuture(d, L, t))
        || (d.market == 'wins' && validWins(d, L, t))
        || (d.market == 'parlay' && validParlay(d, L, t))
        || (d.market != 'future' && d.market != 'wins' && d.market != 'parlay' && validGameWager(d, t, L)));
    }
    // Parlay cash out: the owner can settle their own open parlay early once more than half its legs have won
    // (none lost, at least one still open). Pays at most the stake's profit on the winning legs alone x 0.75,
    // using the odds locked in at placement. Legs are unrolled because rules have no loops (max 6 legs).
    function legDec(l) { return l.odds > 0 ? 1.0 + l.odds / 100.0 : 1.0 + 100.0 / (0 - l.odds); }
    function res(ls, i) { return ls.size() > i ? ls[i].get('result', 'open') : 'none'; }
    function wonD(ls, i) { return res(ls, i) == 'won' ? legDec(ls[i]) : 1.0; }
    function wonN(ls, i) { return res(ls, i) == 'won' ? 1 : 0; }
    function lostN(ls, i) { return res(ls, i) == 'lost' ? 1 : 0; }
    function openN(ls, i) { return res(ls, i) == 'open' ? 1 : 0; }
    function validCashOut() {
      let o = resource.data;
      let n = request.resource.data;
      let ls = o.legs;
      let won = wonN(ls, 0) + wonN(ls, 1) + wonN(ls, 2) + wonN(ls, 3) + wonN(ls, 4) + wonN(ls, 5);
      let lost = lostN(ls, 0) + lostN(ls, 1) + lostN(ls, 2) + lostN(ls, 3) + lostN(ls, 4) + lostN(ls, 5);
      let pending = openN(ls, 0) + openN(ls, 1) + openN(ls, 2) + openN(ls, 3) + openN(ls, 4) + openN(ls, 5);
      let dec = wonD(ls, 0) * wonD(ls, 1) * wonD(ls, 2) * wonD(ls, 3) * wonD(ls, 4) * wonD(ls, 5);
      return signedIn() && o.uid == request.auth.uid && o.market == 'parlay' && o.status == 'open' && ls.size() <= 6
        && league().bettingOpen == true
        && n.diff(o).affectedKeys().hasOnly(['status', 'payout', 'cashedAt', 'settledAt', 'upd'])
        && n.status == 'cashed' && n.payout is number && n.payout >= 0
        && won * 2 > ls.size() && lost == 0 && pending > 0
        && n.payout <= o.stake * (dec - 1.0) * 0.75 + 0.01;
    }
    // Cancelling an open bet: the site marks it deleted (instead of erasing it) so other visitors' snapshots
    // pick up the change. Same conditions as deleting it.
    function validCancel() {
      let o = resource.data;
      let n = request.resource.data;
      return signedIn() && o.uid == request.auth.uid && o.status == 'open'
        && n.diff(o).affectedKeys().hasOnly(['deleted', 'upd']) && n.deleted == true
        && league().bettingOpen == true
        && (((o.market == 'future' || o.market == 'wins') && league().phase == 'Regular Season')
          || (o.market != 'future' && o.market != 'wins' && o.market != 'parlay' && gameOf(o.gameId).get('homeScore', null) == null));
    }
    match /wagers/{id} {
      allow read: if true;
      allow create: if signedIn() && validWager(request.resource.data);
      allow update: if isCommish() || validCashOut() || validCancel();
      allow delete: if isCommish() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'open'
        && league().bettingOpen == true
        && (((resource.data.market == 'future' || resource.data.market == 'wins') && league().phase == 'Regular Season')
          || (resource.data.market != 'future' && resource.data.market != 'wins' && resource.data.market != 'parlay' && gameOf(resource.data.gameId).get('homeScore', null) == null)));
    }

    // Kickoff invites: a coach in a user game proposes 1-3 future times for a game this week or next;
    // the other coach (whose account is linked to the opposing team) accepts one or declines.
    // The sender can cancel while pending; either coach can cancel an accepted time to reschedule.
    function validInvite(d) {
      let L = league();
      let g = gameOf(d.gameId);
      let me = userDoc().data;
      let oppTeam = me.teamId == g.home ? g.away : g.home;
      let now = request.time.toMillis();
      return isCoach() && d.from == request.auth.uid && d.status == 'pending'
        && d.keys().hasOnly(['gameId', 'season', 'week', 'from', 'to', 'fromName', 'toName', 'times', 'status', 'ts', 'upd'])
        && d.times is list && d.times.size() >= 1 && d.times.size() <= 3
        && d.times[0] is number && d.times[0] > now
        && (d.times.size() < 2 || (d.times[1] is number && d.times[1] > now))
        && (d.times.size() < 3 || (d.times[2] is number && d.times[2] > now))
        && g.season == L.season && g.get('homeScore', null) == null && d.week == g.week && d.season == g.season
        && ((L.phase == 'Regular Season' && (g.week == L.week || g.week == L.week + 1))
          || (L.phase == 'Conference Championship' && g.get('type', 'reg') == 'ccg' && g.week == L.week))
        && (me.teamId == g.home || me.teamId == g.away)
        && d.to != '' && d.to == get(/databases/$(database)/documents/teams/$(oppTeam)).data.uid;
    }
    function inviteUpdate() {
      let o = resource.data;
      let n = request.resource.data;
      let ch = n.diff(o).affectedKeys();
      return signedIn() && (
        (o.status == 'pending' && request.auth.uid == o.to && ch.hasOnly(['status', 'time', 'respondedAt', 'upd'])
          && ((n.status == 'accepted' && n.time in o.times) || n.status == 'declined'))
        || (o.status == 'pending' && request.auth.uid == o.from && ch.hasOnly(['status', 'respondedAt', 'upd']) && n.status == 'cancelled')
        || (o.status == 'accepted' && (request.auth.uid == o.to || request.auth.uid == o.from) && ch.hasOnly(['status', 'respondedAt', 'upd']) && n.status == 'cancelled'));
    }
    match /invites/{id} {
      allow read: if true;
      allow create: if validInvite(request.resource.data) || isCommish();   // the commissioner can set a kickoff agreed elsewhere
      allow update: if isCommish() || inviteUpdate();
      allow delete: if isCommish();
    }

    // Game of the Week votes: cast during week N for a game in week N+1. Doc id = season_week_uid.
    match /gotw/{id} {
      allow read: if true;
      allow create, update: if isCoach()
        && id == string(request.resource.data.season) + '_' + string(request.resource.data.week) + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.season == league().season
        && request.resource.data.week == league().week + 1
        && gameOf(request.resource.data.gameId).week == request.resource.data.week;
      allow delete: if isCommish();
    }

    // Awards ballots: private to the voter and the commissioner. Doc id = season_uid.
    match /ballots/{id} {
      allow list: if isCommish();
      allow get: if isCommish() || (signedIn() && id.matches('.*_' + request.auth.uid));
      allow create, update: if isCoach()
        && id == string(league().season) + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.season == league().season
        && league().awards.open == true;
      allow delete: if isCommish();
    }

    // Preseason picks: doc id = season_uid. Coaches make them from publishing until the first score of the season
    // (the site closes league.prePicks then). While open each coach sees only their own; once closed they're public.
    match /picks/{id} {
      allow get, list: if isCommish() || !(league().get('prePicks', {}).get('open', false) == true)
        || (signedIn() && id.matches('.*_' + request.auth.uid));
      allow create, update: if isCoach()
        && id == string(league().season) + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.season == league().season
        && league().get('prePicks', {}).get('open', false) == true
        && league().prePicks.season == league().season;
      allow delete: if isCommish();
    }

    // Phone notification devices: each coach registers their own device's push token. Only the owner can see
    // or change it; the GitHub workflow reads them with the service account (which skips these rules).
    match /push/{id} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'prefs', 'ts', 'welcomed'])
        && request.resource.data.token is string && request.resource.data.token.size() < 500
        && request.resource.data.prefs is map;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'prefs', 'ts', 'welcomed'])
        && request.resource.data.token is string && request.resource.data.token.size() < 500;
    }
  }
}
