rules_version = '2';
// OEC CFB League Hub — paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isCommish() { return hasProfile() && userDoc().data.role == 'commish'; }
    function isCoach() { return hasProfile() && userDoc().data.teamId != ''; }
    function league() { return get(/databases/$(database)/documents/meta/league).data; }
    function gameOf(id) { return get(/databases/$(database)/documents/games/$(id)).data; }

    // League data: everyone can read, only the commissioner can change it.
    match /meta/{doc} { allow read: if true; allow write: if isCommish(); }
    match /teams/{id} { allow read: if true; allow write: if isCommish(); }
    match /games/{id} { allow read: if true; allow write: if isCommish(); }
    match /history/{id} { allow read: if true; allow write: if isCommish(); }

    // Coach profiles. New sign-ups start unlinked; only the commissioner links teams or grants roles.
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'teamId', 'role'])
        && request.resource.data.role == 'coach' && request.resource.data.teamId == ''
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow update: if isCommish() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isCommish();
    }

    // Wagers: a linked coach may bet on any unplayed game this week or later at its posted line,
    // or on the League Champion future at the posted odds during the regular season.
    function baseWager(d, L) {
      return d.uid == request.auth.uid && d.status == 'open' && d.payout == 0
        && d.stake is int && d.stake >= 1 && d.stake <= 100000
        && L.bettingOpen == true && d.season == L.season && d.week == L.week;
    }
    function validGameWager(d) {
      let g = gameOf(d.gameId);
      return g.season == league().season && g.week >= league().week && g.homeScore == null
        && ((d.market == 'ml' && ((d.pick == 'home' && d.odds == g.lines.mlHome) || (d.pick == 'away' && d.odds == g.lines.mlAway)))
          || (d.market == 'spread' && d.line == g.lines.spread && ((d.pick == 'home' && d.odds == g.lines.spreadOddsHome) || (d.pick == 'away' && d.odds == g.lines.spreadOddsAway)))
          || (d.market == 'total' && d.line == g.lines.total && ((d.pick == 'over' && d.odds == g.lines.overOdds) || (d.pick == 'under' && d.odds == g.lines.underOdds))));
    }
    function validFuture(d, L) {
      return L.phase == 'Regular Season' && L.futures.season == L.season && L.futures.open == true
        && d.pick in L.futures.odds && d.odds is int && d.odds == L.futures.odds[d.pick];
    }
    // Parlay: 2-6 legs, each checked like a single bet (game line or League Champion odds).
    function validWins(d, L) {
      let o = L.winTotals.odds[d.team];
      return L.phase == 'Regular Season' && L.winTotals.season == L.season && d.team is string && d.team in L.winTotals.odds
        && d.line == o.line && ((d.pick == 'over' && d.odds == o.over) || (d.pick == 'under' && d.odds == o.under));
    }
    function validLeg(leg, L) {
      return (leg.market == 'future' && validFuture(leg, L)) || (leg.market == 'wins' && validWins(leg, L))
        || (leg.market != 'future' && leg.market != 'wins' && validGameWager(leg));
    }
    function validParlay(d, L) {
      let n = d.legs.size();
      return d.legs is list && n >= 2 && n <= 6
        && validLeg(d.legs[0], L) && validLeg(d.legs[1], L)
        && (n < 3 || validLeg(d.legs[2], L)) && (n < 4 || validLeg(d.legs[3], L))
        && (n < 5 || validLeg(d.legs[4], L)) && (n < 6 || validLeg(d.legs[5], L));
    }
    // Game of the Week +10% profit boost: only on single bets on the GOTW, or parlays made only of its lines.
    function validBoost(d, L) {
      return !('boost' in d) || (d.boost == 1.1 && L.gotw.season == L.season && L.gotw.week == L.week && L.gotw.gameId != ''
        && ((d.market in ['ml', 'spread', 'total'] && d.gameId == L.gotw.gameId)
          || (d.market == 'parlay' && d.legs.size() <= 3 && d.legs[0].gameId == L.gotw.gameId
            && (d.legs.size() < 2 || d.legs[1].gameId == L.gotw.gameId)
            && (d.legs.size() < 3 || d.legs[2].gameId == L.gotw.gameId))));
    }
    function validWager(d) {
      let L = league();
      return baseWager(d, L) && validBoost(d, L) && ((d.market == 'future' && validFuture(d, L))
        || (d.market == 'wins' && validWins(d, L))
        || (d.market == 'parlay' && validParlay(d, L))
        || (d.market != 'future' && d.market != 'wins' && d.market != 'parlay' && validGameWager(d)));
    }
    // Parlay cash out: the owner can settle their own open parlay early once more than half its legs have won
    // (none lost, at least one still open). Pays at most the stake's profit on the winning legs alone x 0.75,
    // using the odds locked in at placement. Legs are unrolled because rules have no loops (max 6 legs).
    function legDec(l) { return l.odds > 0 ? 1.0 + l.odds / 100.0 : 1.0 + 100.0 / (0 - l.odds); }
    function res(ls, i) { return ls.size() > i ? ls[i].get('result', 'open') : 'none'; }
    function wonD(ls, i) { return res(ls, i) == 'won' ? legDec(ls[i]) : 1.0; }
    function wonN(ls, i) { return res(ls, i) == 'won' ? 1 : 0; }
    function lostN(ls, i) { return res(ls, i) == 'lost' ? 1 : 0; }
    function openN(ls, i) { return res(ls, i) == 'open' ? 1 : 0; }
    function validCashOut() {
      let o = resource.data;
      let n = request.resource.data;
      let ls = o.legs;
      let won = wonN(ls, 0) + wonN(ls, 1) + wonN(ls, 2) + wonN(ls, 3) + wonN(ls, 4) + wonN(ls, 5);
      let lost = lostN(ls, 0) + lostN(ls, 1) + lostN(ls, 2) + lostN(ls, 3) + lostN(ls, 4) + lostN(ls, 5);
      let pending = openN(ls, 0) + openN(ls, 1) + openN(ls, 2) + openN(ls, 3) + openN(ls, 4) + openN(ls, 5);
      let dec = wonD(ls, 0) * wonD(ls, 1) * wonD(ls, 2) * wonD(ls, 3) * wonD(ls, 4) * wonD(ls, 5);
      return signedIn() && o.uid == request.auth.uid && o.market == 'parlay' && o.status == 'open' && ls.size() <= 6
        && n.diff(o).affectedKeys().hasOnly(['status', 'payout', 'cashedAt', 'settledAt'])
        && n.status == 'cashed' && n.payout is number && n.payout >= 0
        && won * 2 > ls.size() && lost == 0 && pending > 0
        && n.payout <= o.stake * (dec - 1.0) * 0.75 + 0.01;
    }
    match /wagers/{id} {
      allow read: if true;
      allow create: if isCoach() && validWager(request.resource.data);
      allow update: if isCommish() || validCashOut();
      allow delete: if isCommish() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'open'
        && league().bettingOpen == true
        && (((resource.data.market == 'future' || resource.data.market == 'wins') && league().phase == 'Regular Season')
          || (resource.data.market != 'future' && resource.data.market != 'wins' && resource.data.market != 'parlay' && gameOf(resource.data.gameId).homeScore == null)));
    }

    // Kickoff invites: a coach in a user game proposes 1-3 future times for a game this week or next;
    // the other coach (whose account is linked to the opposing team) accepts one or declines.
    // The sender can cancel while pending; either coach can cancel an accepted time to reschedule.
    function validInvite(d) {
      let L = league();
      let g = gameOf(d.gameId);
      let me = userDoc().data;
      let oppTeam = me.teamId == g.home ? g.away : g.home;
      let now = request.time.toMillis();
      return isCoach() && d.from == request.auth.uid && d.status == 'pending'
        && d.keys().hasOnly(['gameId', 'season', 'week', 'from', 'to', 'fromName', 'toName', 'times', 'status', 'ts'])
        && d.times is list && d.times.size() >= 1 && d.times.size() <= 3
        && d.times[0] is number && d.times[0] > now
        && (d.times.size() < 2 || (d.times[1] is number && d.times[1] > now))
        && (d.times.size() < 3 || (d.times[2] is number && d.times[2] > now))
        && L.phase == 'Regular Season' && g.season == L.season && g.get('homeScore', null) == null
        && (g.week == L.week || g.week == L.week + 1) && d.week == g.week && d.season == g.season
        && (me.teamId == g.home || me.teamId == g.away)
        && d.to != '' && d.to == get(/databases/$(database)/documents/teams/$(oppTeam)).data.uid;
    }
    function inviteUpdate() {
      let o = resource.data;
      let n = request.resource.data;
      let ch = n.diff(o).affectedKeys();
      return signedIn() && (
        (o.status == 'pending' && request.auth.uid == o.to && ch.hasOnly(['status', 'time', 'respondedAt'])
          && ((n.status == 'accepted' && n.time in o.times) || n.status == 'declined'))
        || (o.status == 'pending' && request.auth.uid == o.from && ch.hasOnly(['status', 'respondedAt']) && n.status == 'cancelled')
        || (o.status == 'accepted' && (request.auth.uid == o.to || request.auth.uid == o.from) && ch.hasOnly(['status', 'respondedAt']) && n.status == 'cancelled'));
    }
    match /invites/{id} {
      allow read: if true;
      allow create: if validInvite(request.resource.data);
      allow update: if isCommish() || inviteUpdate();
      allow delete: if isCommish();
    }

    // Game of the Week votes: cast during week N for a game in week N+1. Doc id = season_week_uid.
    match /gotw/{id} {
      allow read: if true;
      allow create, update: if isCoach()
        && id == string(request.resource.data.season) + '_' + string(request.resource.data.week) + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.season == league().season
        && request.resource.data.week == league().week + 1
        && gameOf(request.resource.data.gameId).week == request.resource.data.week;
      allow delete: if isCommish();
    }

    // Awards ballots: private to the voter and the commissioner. Doc id = season_uid.
    match /ballots/{id} {
      allow list: if isCommish();
      allow get: if isCommish() || (signedIn() && id.matches('.*_' + request.auth.uid));
      allow create, update: if isCoach()
        && id == string(league().season) + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.season == league().season
        && league().awards.open == true;
      allow delete: if isCommish();
    }

    // Phone notification devices: each coach registers their own device's push token. Only the owner can see
    // or change it; the GitHub workflow reads them with the service account (which skips these rules).
    match /push/{id} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'prefs', 'ts', 'welcomed'])
        && request.resource.data.token is string && request.resource.data.token.size() < 500
        && request.resource.data.prefs is map;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'prefs', 'ts', 'welcomed'])
        && request.resource.data.token is string && request.resource.data.token.size() < 500;
    }
  }
}
